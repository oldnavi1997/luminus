DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/luminus?schema=public"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""
MP_ACCESS_TOKEN=""
MP_WEBHOOK_SECRET=""
MP_PUBLIC_KEY=""
NEXT_PUBLIC_MP_PUBLIC_KEY=""
# ─── Izipay (pasarela Lyra/Krypton V4) ───
# Back Office → Configuración → Tienda → Claves de API REST.
# Si falta cualquiera de las cuatro, la pestaña Izipay del checkout no se muestra.
IZIPAY_API_URL="https://api.micuentaweb.pe"   # "Nombre del servidor API REST"
IZIPAY_USERNAME=""            # usuario / shopId, p. ej. 1234567
IZIPAY_PASSWORD=""            # contraseña REST; TAMBIÉN valida el kr-hash del IPN
IZIPAY_PUBLIC_KEY=""          # clave pública, con el prefijo del shopId ("1234567:publickey_…")
IZIPAY_HMAC_SHA256=""         # clave HMAC-SHA-256; valida el kr-hash del navegador
# Usa las claves de test para probar y las de producción al desplegar: son pares
# distintos y mezclarlos hace que la validación de firma rechace pagos válidos.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET="luminus-products"
# Base de todas las URL absolutas: canonical, og:url, sitemap, robots y el feed
# de catalogo. En produccion tiene que ser el host con el que responde el sitio
# (https://www.luminuseyewear.com); el apex sin www redirige 301 ahi, y apuntar
# al que redirige deja cada canonical colgando de un salto extra.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_ALGOLIA_APP_ID=
NEXT_PUBLIC_ALGOLIA_SEARCH_KEY=
ALGOLIA_ADMIN_KEY=
# El envío de correo va por Resend (lib/email.ts); el bloque SMTP quedó obsoleto.
RESEND_API_KEY=
EMAIL_FROM=
